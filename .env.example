# PixarByte environment variables.
#
# The site builds and runs with NO .env file at all: every service below has a working
# fallback, so the contact form works end to end locally and on Vercel previews.
# The sample values here are recognised as samples and treated as "not set" (anything
# containing "sample", "placeholder" or "example.com"). Replace a sample with a real value
# and that service switches on: no code changes needed.
#
# Local: copy to .env.local and edit. Vercel: Project → Settings → Environment Variables.
# Never commit real keys, and never prefix a secret with NEXT_PUBLIC_ (those reach the browser).
# NEXT_PUBLIC_ values are built into the page, so redeploy after changing them.

# ---------------------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------------------
# The live site's address, used for canonical URLs, the sitemap and links in emails.
NEXT_PUBLIC_SITE_URL=https://pixarbyte.co.uk

# Google Analytics 4 measurement ID (analytics.google.com → Admin → Data streams).
# Leave empty to load no analytics at all.
NEXT_PUBLIC_GA_ID=

# ---------------------------------------------------------------------------------------
# Cloudflare Turnstile (spam protection on the quote form and the quick estimate)
# Get real keys: dash.cloudflare.com → Turnstile → Add widget (add your domains).
# The defaults are Cloudflare's official always-pass TEST keys, used when these are empty.
# ---------------------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---------------------------------------------------------------------------------------
# Resend (email: team notification, client auto-reply, estimate breakdown)
# Get a key: resend.com → API Keys. Verify your sending domain first (Domains → SPF, DKIM).
# Without a real key nothing is sent: each email is printed in full to the server console.
# ---------------------------------------------------------------------------------------
RESEND_API_KEY=re_sample_placeholder
# Sender, on the domain you verified in Resend.
EMAIL_FROM="PixarByte <hello@pixarbyte.co.uk>"
# Where new-lead notifications go.
LEAD_NOTIFY_EMAIL=hello@pixarbyte.co.uk

# ---------------------------------------------------------------------------------------
# Upstash Redis (rate limiting shared across all server instances)
# Get these: console.upstash.com → Create database → REST API section
# (or Vercel → Storage → Upstash). Without them an in-memory limiter with the same limits is used.
# ---------------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://sample-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=sample_upstash_token

# ---------------------------------------------------------------------------------------
# Vercel Blob (attachment uploads, up to 3 files of 10 MB)
# Get this: Vercel → Storage → Create → Blob, then connect it to the project (the token is
# added automatically). Without it, files are kept in the server's temp folder for demos
# and labelled "stored temporarily" in the lead email.
# ---------------------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_sample_token

# ---------------------------------------------------------------------------------------
# Lead storage
# Leads are always saved before any email is sent. With a webhook URL, each lead is POSTed
# as JSON to your CRM / Zapier / Make / Google Sheets webhook (with the secret as a Bearer
# token). Without it, or if the webhook fails, leads are appended to .data/leads.json
# (git-ignored), or to the system temp folder where the project folder is read-only
# (Vercel), which is NOT permanent: set the webhook up before launch.
# ---------------------------------------------------------------------------------------
LEADS_WEBHOOK_URL=https://hooks.example.com/sample-leads
LEADS_WEBHOOK_SECRET=sample_webhook_secret
# Optional: a different path for the local JSON file.
LEADS_FILE=

# ---------------------------------------------------------------------------------------
# Calendly ("Book a call")
# Your event link: calendly.com → Event types → Copy link, e.g. https://calendly.com/pixarbyte/30min
# Without it, "Book a call" opens a "booking calendar coming soon" dialog.
# ---------------------------------------------------------------------------------------
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/sample-pixarbyte/30min

# ---------------------------------------------------------------------------------------
# WhatsApp (optional contact option on /contact)
# Your WhatsApp Business number in international format, digits only, e.g. 447700900123.
# Leave empty to hide the WhatsApp option.
# ---------------------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=
